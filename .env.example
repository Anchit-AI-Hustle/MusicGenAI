# Copy this file to .env for local development. Never commit .env files.
#
# Browser-visible Supabase configuration. Use only publishable/anon values,
# never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Public service endpoints and non-secret model identifiers.
VITE_AI_MUSIC_API_URL=
VITE_SOUNDFONT_URL=
VITE_VOCAL_SERVICE_URL=
VITE_PUNJABI_ACE_STEP_MODEL_ID=
NEXT_PUBLIC_PUNJABI_ACE_STEP_MODEL_ID=

# Server-only credentials. Configure these in the hosting provider's encrypted
# environment settings and access them only from server-side code.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
VITE_AI_MUSIC_API_KEY=

# SECURITY: VITE_* and NEXT_PUBLIC_* values are bundled into browser code.
# Do not use private AI-provider credentials in those variables. Proxy private
# provider requests through an authenticated server-side endpoint instead.
