# Copy this file to .env for local development. Never commit .env files.
#
# Browser-visible Supabase configuration. Use only publishable/anon values,
# never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Public, non-secret asset endpoints.
VITE_SOUNDFONT_URL=
VITE_VOCAL_SERVICE_URL=

# Server-only model identifiers and credentials. Configure these in the hosting
# provider's encrypted environment settings and access them only from server code.
PUNJABI_ACE_STEP_MODEL_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
AI_MUSIC_API_URL=
AI_MUSIC_API_KEY=

# SECURITY: VITE_* and NEXT_PUBLIC_* values are bundled into browser code.
# Never put private AI-provider credentials in browser-visible variables.
